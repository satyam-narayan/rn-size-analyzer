{
  "name": "rn-size-analyzer",
  "version": "0.1.2",
  "description": "Analyze React Native Android APK/AAB and iOS IPA size. Local HTML dashboard for native libraries, dependencies, assets, Hermes, and release config.",
  "keywords": [
    "react-native",
    "react native",
    "reactnative",
    "react-native-cli",
    "react-native-android",
    "react-native-ios",
    "react-native-size",
    "apk",
    "apk-size",
    "apk-analyzer",
    "aab",
    "android-app-bundle",
    "ipa",
    "ipa-size",
    "app-size",
    "bundle-size",
    "bundle-analyzer",
    "size-analyzer",
    "binary-size",
    "mobile",
    "android",
    "ios",
    "expo",
    "hermes",
    "metro",
    "gradle",
    "cocoapods",
    "performance",
    "cli"
  ],
  "license": "MIT",
  "author": "Satyam Narayan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satyam-narayan/rn-size-analyzer.git"
  },
  "homepage": "https://github.com/satyam-narayan/rn-size-analyzer#readme",
  "bugs": {
    "url": "https://github.com/satyam-narayan/rn-size-analyzer/issues"
  },
  "bin": {
    "rn-size-analyzer": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "templates",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist dist-test",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/tests/unit/*.test.js dist-test/tests/integration/*.test.js",
    "test:unit": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/tests/unit/*.test.js",
    "test:integration": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/tests/integration/*.test.js",
    "cli": "node dist/cli/index.js",
    "analyze": "node dist/cli/index.js"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
